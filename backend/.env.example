# ============================================================
# SERVIDOR
# ============================================================
PORT=3000

# ============================================================
# BANCO DE DADOS — Railway PostgreSQL
# ============================================================
# Pegue a URL em: Railway Dashboard → seu projeto → PostgreSQL → Variables → DATABASE_URL
# Formato Railway:
#   postgresql://<user>:<password>@<host>.railway.app:<port>/<database>
#
# Use a URL "Internal" no deploy (latência zero, rede interna Railway)
# Use a URL "External/Public" apenas localmente ou para migrations manuais
DATABASE_URL="postgresql://user:password@host.railway.internal:5432/railway"

# ============================================================
# AUTENTICAÇÃO JWT
# ============================================================
JWT_SECRET="alguma-chave-secreta-e-segura-de-sua-escolha"
JWT_EXPIRES_IN="7d"

# ============================================================
# STORAGE DE ARQUIVOS (FUTURO: Cloudflare R2)
# ============================================================
# Gratuito até 10 GB (Zero custo de tráfego/egress)
# R2_ACCOUNT_ID="seu-account-id-cloudflare"
# R2_ACCESS_KEY_ID="sua-access-key"
# R2_SECRET_ACCESS_KEY="sua-secret-key"
# R2_BUCKET_NAME="treinosapp-uploads"
# R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
