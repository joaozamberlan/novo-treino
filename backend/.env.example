# ============================================================
# SERVIDOR
# ============================================================
PORT=3000

# ============================================================
# BANCO DE DADOS — Railway PostgreSQL
# ============================================================
# Pegue a URL em: Railway Dashboard → seu projeto → PostgreSQL → Variables → DATABASE_URL
# Formato Railway:
#   postgresql://<user>:<password>@<host>.railway.app:<port>/<database>
#
# Use a URL "Internal" no deploy (latência zero, rede interna Railway)
# Use a URL "External/Public" apenas localmente ou para migrations manuais
DATABASE_URL="postgresql://user:password@host.railway.internal:5432/railway"

# ============================================================
# AUTENTICAÇÃO JWT
# ============================================================
# OBRIGATÓRIO — não existe valor padrão. Sem esta variável, a aplicação
# falha ao iniciar (proposital: evita assinar tokens com um segredo previsível).
# Gere um valor forte e aleatório, ex.: `openssl rand -base64 48`
JWT_SECRET="defina-um-valor-aleatorio-forte-aqui"
JWT_EXPIRES_IN="7d"

# ============================================================
# CORS
# ============================================================
# Lista de origens permitidas, separadas por vírgula. Se ausente, usa o padrão
# de desenvolvimento (http://localhost:5173) + o domínio de produção conhecido
# (https://novo-treino.vercel.app) — ver DEFAULT_CORS_ORIGINS em src/main.ts.
# Defina explicitamente em produção se o domínio do frontend mudar ou se
# houver múltiplos domínios (ex.: preview deployments da Vercel).
# CORS_ORIGIN="https://novo-treino.vercel.app,https://app.seudominio.com"

# ============================================================
# SEED DE ADMIN (opcional, SOMENTE desenvolvimento local)
# ============================================================
# Por padrão nenhuma conta admin é criada automaticamente. Para criar uma
# conta SUPERADMIN de teste no seu ambiente local, defina as três variáveis
# abaixo. Nunca defina SEED_ADMIN em produção/Railway.
# SEED_ADMIN="true"
# SEED_ADMIN_EMAIL="admin@localhost.dev"
# SEED_ADMIN_PASSWORD="escolha-uma-senha-local-forte"

# ============================================================
# STORAGE DE ARQUIVOS (FUTURO: Cloudflare R2)
# ============================================================
# Gratuito até 10 GB (Zero custo de tráfego/egress)
# R2_ACCOUNT_ID="seu-account-id-cloudflare"
# R2_ACCESS_KEY_ID="sua-access-key"
# R2_SECRET_ACCESS_KEY="sua-secret-key"
# R2_BUCKET_NAME="treinosapp-uploads"
# R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
