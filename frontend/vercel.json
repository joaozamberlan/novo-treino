{
  "rewrites": [
    {
      "source": "/v/:token/manifest.webmanifest",
      "destination": "https://novo-treino-production-3354.up.railway.app/publico/manifest/:token"
    },
    { "source": "/v/:token", "destination": "/aluno.html" },
    { "source": "/v/:token/", "destination": "/aluno.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
